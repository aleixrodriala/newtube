<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Touch UI theme for the stmobile flavor.

      Deliberately Theme.MaterialComponents (NOT a Theme.AppCompat fallback): Material
      Components 1.5.0 (`materialVersion` in SharedModules/constants.gradle) is already
      pulled into this exact Gradle module graph at runtime via the `chatkit` library
      dependency (smarttubetv/build.gradle -> implementation project(':chatkit') ->
      com.google.android.material:material:1.5.0), and `filepicker-lib` (a dependency
      of `common`) depends on the same artifact/version. So Material Components was
      already proven to resolve cleanly against this project's pinned
      appcompat/fragment/leanback versions before this change - no fallback to
      AppCompat + cardview was needed.
    -->
    <style name="Theme.NewTube" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mobile_color_primary</item>
        <item name="colorPrimaryDark">@color/mobile_color_primary_dark</item>
        <item name="colorAccent">@color/mobile_color_accent</item>
        <item name="android:colorBackground">@color/mobile_color_background</item>
        <item name="colorSurface">@color/mobile_color_surface</item>
        <item name="colorOnSurface">@color/mobile_color_on_surface</item>
        <item name="android:windowBackground">@color/mobile_color_background</item>
        <!-- Solid app-colored system bars from the first frame (otherwise colorPrimaryDark red
             flashes in the status bar until the runtime chrome in MobileActivity lands). -->
        <item name="android:statusBarColor">@color/mobile_color_background</item>
        <item name="android:navigationBarColor">@color/mobile_color_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAnimationStyle">@style/BrowseWindowAnimation</item>
    </style>

    <!--
      Window open/close transitions for the touch player. Set via android:windowAnimationStyle
      on Theme.NewTube.Player so the player fades+scales in when launched from a card and
      fades+slides down when closed - without having to touch the (shared, presenter-driven)
      ViewManager.startActivity() launch site. windowBackground stays opaque black to avoid a
      white/black flash on the cold open before the first decoded frame.
    -->
    <style name="PlayerWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/player_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/player_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/player_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/player_close_exit</item>
        <!-- The player is singleInstance = its own TASK, so launching it from Browse (and
             re-expanding it from the mini-player) is a TASK transition: the activity* items
             above never fired for it and the system fell back to the stock cross-task zoom -
             the mismatched "whole transition" feel on device. Same animations, task slots. -->
        <item name="android:taskOpenEnterAnimation">@anim/player_open_enter</item>
        <item name="android:taskOpenExitAnimation">@anim/player_open_exit</item>
        <item name="android:taskToFrontEnterAnimation">@anim/player_open_enter</item>
        <item name="android:taskToFrontExitAnimation">@anim/player_open_exit</item>
        <item name="android:taskToBackEnterAnimation">@anim/player_close_enter</item>
        <item name="android:taskToBackExitAnimation">@anim/player_close_exit</item>
    </style>

    <!--
      Browse window animations. With every touch activity in ONE shared task (manifest note),
      surfacing this screen is a plain in-task "open" - most importantly on MINIMIZE, where the
      player hand-animates the video shrinking onto the mini-card and Browse then fades in
      underneath it (160ms), reading as one continuous motion. Applies theme-wide (Theme.NewTube),
      so Search/Channel/etc. get the same quick fade instead of the stock sideways slide - the
      YouTube-like "no transitions between screens" feel. task* slots kept as a fallback for any
      residual cross-task switch (e.g. external deep links).
    -->
    <style name="BrowseWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/browse_to_front_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/mobile_stay</item>
        <item name="android:activityCloseEnterAnimation">@anim/mobile_stay</item>
        <item name="android:activityCloseExitAnimation">@anim/mobile_fade_out</item>
        <item name="android:taskToFrontEnterAnimation">@anim/browse_to_front_enter</item>
        <item name="android:taskToFrontExitAnimation">@anim/mobile_stay</item>
    </style>

    <!--
      PLAYER LAYOUT POLISH: the player must NOT inherit the app surface's solid status-bar colour
      (which draws a coloured band across the top of the video/title). Draw our own system-bar
      backgrounds with a TRANSPARENT status bar so the video + the top gradient scrim show through;
      the navigation bar takes the watch-page background so the portrait content column reads cleanly.
      windowTranslucentStatus=false is required so the transparent statusBarColor actually applies
      (a translucent status bar would draw a system scrim instead). The runtime code in
      MobilePlaybackActivity.applyPortraitTransparentBars() re-asserts this per-orientation because
      MotherActivity.makeActivityFullscreen2() sets FLAG_TRANSLUCENT_STATUS on every resume.
    -->
    <style name="Theme.NewTube.Player" parent="Theme.NewTube">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@style/PlayerWindowAnimation</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:statusBarColor">@color/mobile_color_background</item>
        <item name="android:navigationBarColor">@color/mobile_color_background</item>
    </style>

    <!--
      Translucent theme for MobileAppDialogActivity (context menus, player option pickers,
      settings). Mirrors the proven TV overlay theme (App.Theme.Leanback.Preferences:
      windowIsTranslucent + transparent windowBackground + backgroundDimEnabled=false):

        * No black flash - the window starts transparent, so the caller (Home / the player)
          shows through until the dialog content is laid out.
        * No force-rotate - a translucent activity defers screen orientation to the opaque
          activity behind it, so opening a picker from the LANDSCAPE player no longer snaps to
          portrait (the manifest keeps screenOrientation="unspecified"; a translucent window must
          NOT request a fixed orientation - "Only fullscreen opaque activities can request
          orientation" on API 26).
        * The activity draws its own scrim + bottom sheet (or an opaque full-screen surface),
          so backgroundDimEnabled is left off and window animations are handled per-mode in code.
    -->
    <style name="Theme.NewTube.Dialog" parent="Theme.NewTube">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Material 3 nav metrics (matches YouTube/Gmail): drawer rows = Label Large (14sp medium)
         with a pill-shaped selected highlight; navigation bar = 80dp tall, 24dp icons, 12sp
         medium labels. The "bigger" feel of Google apps comes from bar HEIGHT + spacing, not
         oversized glyphs. -->
    <style name="MobileDrawerItemText" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="MobileDrawerItemShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="MobileBottomNavText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Watch-page loading skeleton (alpha-pulsed from code while related videos load). -->
    <style name="MobileSkeletonRelatedRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingVertical">6dp</item>
    </style>
    <style name="MobileSkeletonRelatedThumb">
        <item name="android:layout_width">@dimen/mobile_watch_related_thumb_width</item>
        <item name="android:layout_height">@dimen/mobile_watch_related_thumb_height</item>
        <item name="android:background">@drawable/bg_skeleton_block</item>
    </style>
    <style name="MobileSkeletonRelatedTextColumn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>
    <style name="MobileSkeletonRelatedLineWide">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:background">@drawable/bg_skeleton_block</item>
    </style>
    <style name="MobileSkeletonRelatedLineNarrow">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_skeleton_block</item>
    </style>
</resources>
