<?xml version="1.0" encoding="utf-8"?>
<!--
  Captions sheet, modeled 1:1 on the official app's Subtitles picker: a plain title with a
  hairline divider, then ONE flat choice list ("Off", the video's tracks, autogenerated /
  auto-translated variants - their labels already carry the "(auto-generated)" wording), and a
  footer row for caption appearance settings (style/size/position + per-channel memory). Rows
  are item_mobile_quality_row (leading check gutter), filled in
  MobilePlaybackActivity.showCaptionsSheet(). Replaces the TV-style AppDialog track picker.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mobile_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_mobile_sheet_handle" />

        <TextView
            android:id="@+id/captions_sheet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:text="@string/mobile_player_subtitles"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mobile_color_divider" />

        <LinearLayout
            android:id="@+id/captions_sheet_track_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/captions_sheet_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:text="@string/mobile_captions_empty"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <View
            android:id="@+id/captions_sheet_style_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/mobile_color_divider" />

        <LinearLayout
            android:id="@+id/captions_sheet_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="13dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mobile_captions_style"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/mobile_color_on_surface_secondary" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
