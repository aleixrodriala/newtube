<?xml version="1.0" encoding="utf-8"?>
<!--
  Touch device-code sign-in screen - Wave 5 (ARCHITECTURE.md section 7).

  Renders what YTSignInPresenter pushes through SignInView.showCode(): the user code
  (large + tap-to-copy), the verification URL (tappable link), and a prominent
  "Open sign-in page" button. On a phone there is nothing to scan, so instead of a QR
  the activation page is opened directly in the device browser when the code arrives
  (see MobileSignInActivity.showCode); the button re-opens it on demand.
  A spinner shows until the first code arrives from the backend; errors (SignInView's 2-arg
  showCode path) render as a friendly headline + raw-detail line + "Try again" button that
  restarts the flow with a fresh code. The account/auth backend is untouched - this view only
  renders.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_signin_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mobile_color_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/mobile_signin_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:background="@color/mobile_color_background"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/mobile_signin_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_back"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_back_arrow" />

        <TextView
            android:id="@+id/mobile_signin_toolbar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingEnd="16dp"
            android:text="@string/mobile_signin_title"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ProgressBar
                android:id="@+id/mobile_signin_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="64dp"
                android:indeterminateTint="@color/mobile_color_primary" />

            <!--
              Error state: a human-readable headline + "Try again" (restarts the flow with a
              fresh device code). The raw backend error goes to the small detail line below it,
              for tester bug reports - never as the main message.
            -->
            <LinearLayout
                android:id="@+id/mobile_signin_error_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/mobile_signin_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/mobile_signin_error"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/mobile_signin_error_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="4"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="java.net.UnknownHostException: Unable to resolve host"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mobile_signin_retry_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/mobile_signin_retry_button"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="16sp"
                    app:backgroundTint="@color/mobile_color_primary"
                    app:cornerRadius="24dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/mobile_signin_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="32dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/mobile_signin_instructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/mobile_signin_instructions"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="15sp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mobile_signin_code_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/mobile_color_placeholder"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/mobile_color_on_surface_secondary">

                    <TextView
                        android:id="@+id/mobile_signin_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.15"
                        android:paddingStart="28dp"
                        android:paddingEnd="28dp"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp"
                        android:textColor="@color/mobile_color_on_surface"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        tools:text="ABC-DEF" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/mobile_signin_copy_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/mobile_signin_copy_hint"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/mobile_signin_url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:textColor="@color/mobile_color_link"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="https://yt.be/activate" />

                <TextView
                    android:id="@+id/mobile_signin_open_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mobile_signin_open_hint"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="12sp" />

                <!--
                  Primary action: (re)open the code-prefilled activation page in the device browser.
                  It is auto-opened once when the code arrives (see MobileSignInActivity.showCode);
                  this button lets the user get back to it after backgrounding / dismissing the tab.
                  Replaces the QR area of the TV path - a phone has nothing to scan from.
                -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mobile_signin_open_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/mobile_signin_open_button"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="16sp"
                    app:backgroundTint="@color/mobile_color_primary"
                    app:cornerRadius="24dp" />

            </LinearLayout>

        </FrameLayout>

    </ScrollView>

</LinearLayout>
