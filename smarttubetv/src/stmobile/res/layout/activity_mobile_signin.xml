<?xml version="1.0" encoding="utf-8"?>
<!--
  Touch device-code sign-in screen, guided-onboarding edition.

  The device-code OAuth flow is a TV flow running on a phone, so this screen's whole job is
  guidance: a 3-step list explains what is about to happen ("Continue with Google" -> approve on
  Google's page -> come back), the pairing code is kept visible but demoted to a small
  "check it matches" row (Google's approval UI displays the same code and users want to compare),
  and the primary button sits right under the steps. Four states, one container each:
    - progress: spinner until the first code arrives from the backend
    - content:  the READY state described above (+ manual yt.be/activate fallback link)
    - waiting:  after the user opens the approval page - spinner + "finish on the Google page",
                the code to match, and a re-open button
    - success:  checkmark confirmation; MobileSignInActivity relaunches itself CLEAR_TOP to
                dismiss the Custom Tab, shows this briefly, then finishes
    - error:    friendly headline + raw-detail line + "Try again" (fresh code)
  The account/auth backend is untouched - this view only renders.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_signin_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mobile_color_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/mobile_signin_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:background="@color/mobile_color_background"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/mobile_signin_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_back"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_back_arrow" />

        <TextView
            android:id="@+id/mobile_signin_toolbar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingEnd="16dp"
            android:text="@string/mobile_signin_title"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ProgressBar
                android:id="@+id/mobile_signin_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/mobile_color_primary" />

            <!--
              Error state: a human-readable headline + "Try again" (restarts the flow with a
              fresh device code). The raw backend error goes to the small detail line below it,
              for tester bug reports - never as the main message.
            -->
            <LinearLayout
                android:id="@+id/mobile_signin_error_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    android:id="@+id/mobile_signin_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/mobile_signin_error"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/mobile_signin_error_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="4"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="java.net.UnknownHostException: Unable to resolve host" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mobile_signin_retry_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/mobile_signin_retry_button"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="16sp"
                    app:backgroundTint="@color/mobile_color_primary"
                    app:cornerRadius="24dp" />

            </LinearLayout>

            <!-- READY state: guided steps + demoted code row + primary action + manual fallback. -->
            <LinearLayout
                android:id="@+id/mobile_signin_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="32dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/mobile_signin_lead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mobile_signin_lead"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="15sp" />

                <!-- Step 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_mobile_signin_step"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/mobile_color_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mobile_signin_step1_title"
                            android:textColor="@color/mobile_color_on_surface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/mobile_signin_step1_caption"
                            android:textColor="@color/mobile_color_on_surface_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Step 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_mobile_signin_step"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/mobile_color_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mobile_signin_step2_title"
                            android:textColor="@color/mobile_color_on_surface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/mobile_signin_step2_caption"
                            android:textColor="@color/mobile_color_on_surface_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Step 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_mobile_signin_step"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/mobile_color_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mobile_signin_step3_title"
                            android:textColor="@color/mobile_color_on_surface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/mobile_signin_step3_caption"
                            android:textColor="@color/mobile_color_on_surface_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

                <!--
                  The pairing code, demoted: Google's approval UI shows the same code, so keep it
                  visible for comparison (and tap-to-copy for the manual path) without letting it
                  dominate the screen the way the TV layout did.
                -->
                <TextView
                    android:id="@+id/mobile_signin_code_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/mobile_signin_code_label"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mobile_signin_code_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/mobile_color_placeholder"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/mobile_color_on_surface_secondary">

                    <TextView
                        android:id="@+id/mobile_signin_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.1"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:textColor="@color/mobile_color_on_surface"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="ABC-DEF" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/mobile_signin_copy_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/mobile_signin_copy_hint"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mobile_signin_open_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/mobile_signin_open_button"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="16sp"
                    app:backgroundTint="@color/mobile_color_primary"
                    app:cornerRadius="26dp" />

                <TextView
                    android:id="@+id/mobile_signin_manual_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="@string/mobile_signin_manual_hint"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/mobile_signin_url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:textColor="@color/mobile_color_link"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="https://yt.be/activate" />

            </LinearLayout>

            <!-- WAITING state: user is (or was) on the Google approval page. -->
            <LinearLayout
                android:id="@+id/mobile_signin_waiting_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:visibility="gone"
                tools:visibility="gone">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/mobile_color_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/mobile_signin_waiting_title"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/mobile_signin_waiting_caption"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/mobile_signin_code_label"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/mobile_signin_waiting_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="ABC-DEF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mobile_signin_reopen_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/mobile_signin_reopen_button"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="15sp"
                    app:backgroundTint="@color/mobile_color_placeholder"
                    app:cornerRadius="24dp" />

            </LinearLayout>

            <!-- SUCCESS state: shown briefly, then the activity finishes itself. -->
            <LinearLayout
                android:id="@+id/mobile_signin_success_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@string/mobile_signin_success"
                    android:src="@drawable/ic_mobile_check"
                    app:tint="@color/mobile_color_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/mobile_signin_success"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

    </ScrollView>

</LinearLayout>
