<?xml version="1.0" encoding="utf-8"?>
<!--
  Playback-speed sheet, classic official-app anatomy (same family as sheet_mobile_captions):
  plain title + hairline divider, one flat preset list (0.25x .. 2x, "Normal" for 1x) with a
  leading check on the active speed, and a "More speeds" footer that opens the full TV speed
  dialog (extended 0.25-4x list) for power users. Rows are item_mobile_quality_row, filled in
  MobilePlaybackActivity.showSpeedSheet(). Replaces the TV-style AppDialog as the gear target.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mobile_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_mobile_sheet_handle" />

        <TextView
            android:id="@+id/speed_sheet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:text="@string/mobile_player_speed"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mobile_color_divider" />

        <LinearLayout
            android:id="@+id/speed_sheet_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/mobile_color_divider" />

        <LinearLayout
            android:id="@+id/speed_sheet_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="13dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mobile_speed_more"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/mobile_color_on_surface_secondary" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
