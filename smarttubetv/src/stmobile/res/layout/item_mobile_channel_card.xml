<?xml version="1.0" encoding="utf-8"?>
<!--
  Channel result row (search grid, any feed that carries Video.isChannel() items).
  Pure-Material take on YouTube's channel result: round avatar + name + one quiet
  "subscribers · N videos" line. No Subscribe button here — tap opens the channel page
  (normal onVideoItemClicked routing), long-press/⋮ has Subscribe in the context menu.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/channel_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <ImageView
        android:id="@+id/channel_avatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_watch_channel_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/channel_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="15sp"
            tools:text="Channel name" />

        <TextView
            android:id="@+id/channel_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="13sp"
            tools:text="1.2M subscribers · 340 videos" />

    </LinearLayout>

</LinearLayout>
