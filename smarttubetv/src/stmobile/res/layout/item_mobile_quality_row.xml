<?xml version="1.0" encoding="utf-8"?>
<!-- One row in the quality/audio sheet: label + check mark when currently selected. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="13dp">

    <TextView
        android:id="@+id/quality_row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="15sp"
        tools:text="1080p" />

    <ImageView
        android:id="@+id/quality_row_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_mobile_check"
        android:visibility="invisible" />

</LinearLayout>
