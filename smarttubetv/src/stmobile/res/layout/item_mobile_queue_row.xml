<?xml version="1.0" encoding="utf-8"?>
<!--
  NEWTUBE(queue): one row of the queue sheet (QueueSheet): drag handle, thumbnail, title and
  channel, and a remove button. The playing row says "Now playing" on its thumbnail and can't be
  removed or dragged.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/queue_row_handle"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="center"
        android:src="@drawable/ic_queue_drag" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="112dp"
        android:layout_height="63dp"
        app:cardBackgroundColor="@color/mobile_color_placeholder"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/queue_row_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/queue_row_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:background="@drawable/bg_video_badge"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="12:34"
            tools:visibility="visible" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/queue_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="14sp"
            tools:text="A video title that may run onto a second line" />

        <TextView
            android:id="@+id/queue_row_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="12sp"
            tools:text="Channel" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/queue_row_remove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/remove_from_playback_queue"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_sheet_close"
        android:tint="@color/mobile_color_on_surface_secondary" />

</LinearLayout>
