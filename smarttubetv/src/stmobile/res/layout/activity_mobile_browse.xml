<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_browse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mobile_color_background">

    <TextView
        android:id="@+id/mobile_title_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:background="@color/mobile_color_surface"
        android:elevation="4dp"
        android:gravity="center_vertical|start"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/app_name"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mobile_content_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/mobile_card_spacing"
        android:paddingBottom="@dimen/mobile_card_spacing"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_title_bar"
        tools:listitem="@layout/item_video_card" />

    <ProgressBar
        android:id="@+id/mobile_progress_bar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/mobile_content_grid"
        app:layout_constraintEnd_toEndOf="@id/mobile_content_grid"
        app:layout_constraintStart_toStartOf="@id/mobile_content_grid"
        app:layout_constraintTop_toTopOf="@id/mobile_content_grid" />

    <LinearLayout
        android:id="@+id/mobile_error_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/mobile_content_grid"
        app:layout_constraintEnd_toEndOf="@id/mobile_content_grid"
        app:layout_constraintStart_toStartOf="@id/mobile_content_grid"
        app:layout_constraintTop_toTopOf="@id/mobile_content_grid">

        <TextView
            android:id="@+id/mobile_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mobile_error_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/mobile_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/mobile_color_surface"
        app:itemIconTint="@color/mobile_color_on_surface"
        app:itemTextColor="@color/mobile_color_on_surface"
        app:labelVisibilityMode="auto"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
