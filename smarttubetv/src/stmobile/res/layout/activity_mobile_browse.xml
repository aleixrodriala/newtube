<?xml version="1.0" encoding="utf-8"?>
<!-- Home shell. The DrawerLayout hosts the browse content plus a navigation drawer
     that exposes EVERY section BrowsePresenter delivers via addSection() (the 5-item
     bottom nav can only show the main ones). Tapping a drawer item drives the exact
     same BrowsePresenter.onSectionFocused() path the bottom nav uses. -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"><!--
    No fitsSystemWindows needed: MobileActivity.applyMobileSystemBars() keeps the decor fitting
    the system windows (solid app-colored status/nav bars), so the DrawerLayout never renders
    under the bars regardless of what the player did to the display in between. -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mobile_browse_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mobile_color_background">

        <ImageButton
            android:id="@+id/mobile_menu_button"
            android:layout_width="48dp"
            android:layout_height="@dimen/mobile_title_bar_height"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_menu_button"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/mobile_title_bar" />

        <TextView
            android:id="@+id/mobile_title_bar"
            android:layout_width="0dp"
            android:layout_height="@dimen/mobile_title_bar_height"
            android:background="@color/mobile_color_background"
            android:gravity="center_vertical|start"
            android:paddingStart="8dp"
            android:text="@string/app_name"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/mobile_search_button"
            app:layout_constraintStart_toEndOf="@id/mobile_menu_button"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/mobile_search_button"
            android:layout_width="48dp"
            android:layout_height="@dimen/mobile_title_bar_height"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_search_button"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_search"
            app:layout_constraintEnd_toStartOf="@id/mobile_settings_button"
            app:layout_constraintTop_toTopOf="@id/mobile_title_bar" />

        <ImageButton
            android:id="@+id/mobile_settings_button"
            android:layout_width="48dp"
            android:layout_height="@dimen/mobile_title_bar_height"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_settings_button"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/mobile_title_bar" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_content_grid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/mobile_card_spacing"
            android:paddingBottom="@dimen/mobile_card_spacing"
            android:scrollbars="vertical"
            app:layout_constraintBottom_toTopOf="@id/mobile_mini_player"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mobile_title_bar"
            tools:listitem="@layout/item_video_card" />

        <!--
             Progress + empty/error placeholder are anchored to the title bar / bottom
             nav / parent (NOT to the content grid): when a section is empty or sign-in
             gated the grid is set GONE, and ConstraintLayout collapses any view
             constrained to a GONE view to a zero-size point - which is exactly why the
             signed-out Subscriptions/Playlists sections used to render as a blank black
             area with no message. Independent anchors keep the placeholder centered and
             visible over the (empty) content area.
        -->
        <ProgressBar
            android:id="@+id/mobile_progress_bar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mobile_title_bar" />

        <LinearLayout
            android:id="@+id/mobile_error_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mobile_title_bar">

            <ImageView
                android:id="@+id/mobile_error_icon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mobile_empty" />

            <TextView
                android:id="@+id/mobile_error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_error_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- YouTube-style in-app mini-player: shows the LIVE player (rendered into the small
             PlayerView via MiniPlayerBridge) docked above the bottom nav after a swipe-down on
             the watch screen. GONE by default; the grid's bottom constraint collapses onto the
             bottom nav when hidden. TextureView surface: composites like a normal view inside
             this scrolling UI (no SurfaceView punch-through), and keeps the main player's own
             SurfaceView free for the handoff back. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mobile_mini_player"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:background="@color/mobile_color_surface"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">

            <com.google.android.exoplayer2.ui.PlayerView
                android:id="@+id/mobile_mini_player_view"
                android:layout_width="110dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:resize_mode="zoom"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <TextView
                android:id="@+id/mobile_mini_player_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="1dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="14sp"
                app:layout_constraintBottom_toTopOf="@id/mobile_mini_player_author"
                app:layout_constraintEnd_toStartOf="@id/mobile_mini_play_pause"
                app:layout_constraintStart_toEndOf="@id/mobile_mini_player_view"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="A video title" />

            <TextView
                android:id="@+id/mobile_mini_player_author"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/mobile_mini_player_title"
                app:layout_constraintStart_toStartOf="@id/mobile_mini_player_title"
                app:layout_constraintTop_toBottomOf="@id/mobile_mini_player_title"
                tools:text="Channel" />

            <ImageButton
                android:id="@+id/mobile_mini_play_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_mini_play_pause"
                android:padding="12dp"
                android:src="@drawable/ic_player_pause"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/mobile_mini_close"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/mobile_mini_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_mini_close"
                android:padding="12dp"
                android:src="@drawable/ic_sheet_close"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ProgressBar
                android:id="@+id/mobile_mini_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:max="1000"
                android:progressBackgroundTint="@color/mobile_color_progress_track"
                android:progressTint="@color/mobile_color_progress"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:progress="400" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/mobile_bottom_nav"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:background="@color/mobile_color_background"
            app:itemIconSize="24dp"
            app:itemIconTint="@color/mobile_bottom_nav_item"
            app:itemTextAppearanceActive="@style/MobileBottomNavText"
            app:itemTextAppearanceInactive="@style/MobileBottomNavText"
            app:itemTextColor="@color/mobile_bottom_nav_item"
            app:labelVisibilityMode="labeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/mobile_nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/mobile_color_surface"
        app:headerLayout="@layout/nav_header_mobile"
        app:itemIconSize="24dp"
        app:itemIconTint="@null"
        app:itemShapeAppearanceOverlay="@style/MobileDrawerItemShape"
        app:itemTextAppearance="@style/MobileDrawerItemText"
        app:itemTextColor="@color/mobile_color_on_surface" />

</androidx.drawerlayout.widget.DrawerLayout>
