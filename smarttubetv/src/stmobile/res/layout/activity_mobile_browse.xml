<?xml version="1.0" encoding="utf-8"?>
<!-- Home shell. The DrawerLayout hosts the browse content plus a navigation drawer
     that exposes EVERY section BrowsePresenter delivers via addSection() (the 5-item
     bottom nav can only show the main ones). Tapping a drawer item drives the exact
     same BrowsePresenter.onSectionFocused() path the bottom nav uses. -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"><!--
    No fitsSystemWindows needed: MobileActivity.applyMobileSystemBars() keeps the decor fitting
    the system windows (solid app-colored status/nav bars), so the DrawerLayout never renders
    under the bars regardless of what the player did to the display in between. -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mobile_browse_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mobile_color_background">

        <ImageButton
            android:id="@+id/mobile_menu_button"
            android:layout_width="48dp"
            android:layout_height="@dimen/mobile_title_bar_height"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_menu_button"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/mobile_title_bar" />

        <TextView
            android:id="@+id/mobile_title_bar"
            android:layout_width="0dp"
            android:layout_height="@dimen/mobile_title_bar_height"
            android:background="@color/mobile_color_background"
            android:gravity="center_vertical|start"
            android:paddingStart="8dp"
            android:text="@string/app_name"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/mobile_search_button"
            app:layout_constraintStart_toEndOf="@id/mobile_menu_button"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/mobile_search_button"
            android:layout_width="48dp"
            android:layout_height="@dimen/mobile_title_bar_height"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_search_button"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_search"
            app:layout_constraintEnd_toStartOf="@id/mobile_settings_button"
            app:layout_constraintTop_toTopOf="@id/mobile_title_bar" />

        <ImageButton
            android:id="@+id/mobile_settings_button"
            android:layout_width="48dp"
            android:layout_height="@dimen/mobile_title_bar_height"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_settings_button"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/mobile_title_bar" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_content_grid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/mobile_card_spacing"
            android:paddingBottom="@dimen/mobile_card_spacing"
            android:scrollbars="vertical"
            app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mobile_title_bar"
            tools:listitem="@layout/item_video_card" />

        <!--
             Progress + empty/error placeholder are anchored to the title bar / bottom
             nav / parent (NOT to the content grid): when a section is empty or sign-in
             gated the grid is set GONE, and ConstraintLayout collapses any view
             constrained to a GONE view to a zero-size point - which is exactly why the
             signed-out Subscriptions/Playlists sections used to render as a blank black
             area with no message. Independent anchors keep the placeholder centered and
             visible over the (empty) content area.
        -->
        <ProgressBar
            android:id="@+id/mobile_progress_bar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mobile_title_bar" />

        <LinearLayout
            android:id="@+id/mobile_error_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mobile_title_bar">

            <ImageView
                android:id="@+id/mobile_error_icon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mobile_empty" />

            <TextView
                android:id="@+id/mobile_error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_error_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- YouTube-style FLOATING mini-player: just the live video (no bar), a rounded card
             hovering over the grid's bottom-right corner above the bottom nav. GONE by default;
             it floats OVER content (like YouTube), so the grid keeps its bottom-nav constraint.
             The video is NOT a PlayerView: the card re-parents the playback activity's
             session-long SurfaceTexture into a code-managed TextureView inside the frame below
             (see MobileBrowseActivity#attachMiniTexture + MiniPlayerBridge.getSessionTexture) -
             the codec's surface never changes, so the hand-off never freezes playback. The
             freeze ImageView shows the last captured frame during attach/detach beats.
             Tap video = expand; overlaid play/pause + X; 2dp progress. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mobile_mini_player"
            android:layout_width="180dp"
            android:layout_height="102dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="@android:color/black"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/mobile_mini_player_frame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/mobile_mini_freeze"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:visibility="gone" />

                </FrameLayout>

                <ImageButton
                    android:id="@+id/mobile_mini_play_pause"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_mini_scrim_circle"
                    android:contentDescription="@string/mobile_mini_play_pause"
                    android:padding="9dp"
                    android:src="@drawable/ic_player_pause" />

                <ImageButton
                    android:id="@+id/mobile_mini_close"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_mini_scrim_circle"
                    android:contentDescription="@string/mobile_mini_close"
                    android:padding="6dp"
                    android:src="@drawable/ic_sheet_close" />

                <ProgressBar
                    android:id="@+id/mobile_mini_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_gravity="bottom"
                    android:max="1000"
                    android:progressBackgroundTint="@color/mobile_color_progress_track"
                    android:progressTint="@color/mobile_color_progress"
                    tools:progress="400" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/mobile_bottom_nav"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:background="@color/mobile_color_background"
            app:itemIconSize="28dp"
            app:itemIconTint="@color/mobile_bottom_nav_item"
            app:itemTextAppearanceActive="@style/MobileBottomNavText"
            app:itemTextAppearanceInactive="@style/MobileBottomNavText"
            app:itemTextColor="@color/mobile_bottom_nav_item"
            app:labelVisibilityMode="labeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/mobile_nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/mobile_color_surface"
        app:headerLayout="@layout/nav_header_mobile"
        app:itemIconSize="24dp"
        app:itemIconTint="@null"
        app:itemShapeAppearanceOverlay="@style/MobileDrawerItemShape"
        app:itemTextAppearance="@style/MobileDrawerItemText"
        app:itemTextColor="@color/mobile_color_on_surface" />

</androidx.drawerlayout.widget.DrawerLayout>
