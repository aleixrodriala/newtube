<?xml version="1.0" encoding="utf-8"?>
<!--
  Touch Search screen (Wave 4b).

  Toolbar = back arrow + a rounded EditText (IME action = search) + a mic button for
  voice input. Below the toolbar, a horizontally-scrolling strip of tag SUGGESTION chips
  (fed live as the user types, via SearchPresenter's MediaServiceSearchTagProvider), and
  under that a single Material RecyclerView GRID of results (reuses VideoCardAdapter and
  the same runtime span-count math + onScrollEnd pagination as the Home/Channel grids).

  Drives the unchanged SearchPresenter via the standard MVP seam; this is the touch
  replacement for the Leanback SearchTagsFragment/SearchTagsActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mobile_color_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/mobile_search_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:background="@color/mobile_color_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/mobile_search_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_back"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_back_arrow" />

        <EditText
            android:id="@+id/mobile_search_input"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/mobile_search_field_background"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="@color/mobile_color_on_surface"
            android:textColorHint="@color/mobile_color_on_surface_secondary"
            android:textSize="18sp" />

        <!-- Clear the query; visible only while the field has text. -->
        <ImageButton
            android:id="@+id/mobile_search_clear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_search_clear"
            android:padding="12dp"
            android:src="@drawable/ic_sheet_close"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/mobile_search_mic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_search_voice"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_mic" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_search_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/mobile_card_spacing"
            android:paddingBottom="@dimen/mobile_card_spacing"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_video_card" />

        <ProgressBar
            android:id="@+id/mobile_search_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- A search that ends with zero rows used to just... stop (spinner gone, screen
             blank). Shown by showProgressBar(false) when the grid is empty; tap = retry. -->
        <TextView
            android:id="@+id/mobile_search_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/mobile_search_empty"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="15sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Suggestions/history: a full-height vertical list OVER the results while the user
             is editing the query (YouTube-style; was a one-line horizontal chip strip).
             Empty query = search history (clock rows), typed query = live suggestions. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_search_suggestions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/mobile_color_background"
            android:paddingTop="4dp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_mobile_search_suggestion"
            tools:visibility="visible" />

    </FrameLayout>

</LinearLayout>
