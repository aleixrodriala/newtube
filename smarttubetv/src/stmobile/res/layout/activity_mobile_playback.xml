<?xml version="1.0" encoding="utf-8"?>
<!--
  Touch WATCH PAGE (PLAYER WATCH PAGE wave, on top of PLAYER POLISH).

  Structure:
    PlayerContainerLayout (root, swipe-DOWN-to-dismiss, scoped to the video area)
      LinearLayout (vertical page)
        FrameLayout  @id/mobile_video_area  - the video + its custom controls overlay.
            Portrait: fixed 16:9 height (set in code). Landscape: match_parent (full-bleed).
            Children (back to front): DoubleTapPlayerView, YouTubeOverlay, controls overlay,
            buffering spinner - exactly the PLAYER POLISH surface, now clipped to the video box.
        NestedScrollView  @id/mobile_watch_scroll  - the YouTube-style content column.
            Portrait: fills the rest and scrolls. Landscape: GONE (immersive video only).
            Holds: title, views/date, actions row (Like/Dislike + counts, Share), channel row
            (avatar + name + Subscribe), expandable description, and the related/up-next list.

  In landscape the content is hidden and the video area is match_parent, restoring the
  PLAYER POLISH immersive full-bleed video with only the custom controls.
-->
<com.newtube.mobile.ui.playback.PlayerContainerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_player_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:keepScreenOn="true">

    <LinearLayout
        android:id="@+id/mobile_watch_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Video area: 16:9 in portrait (set in code), match_parent in landscape.
             PinchZoomLayout adds the YouTube pinch gesture (fill <-> original) over all of it. -->
        <com.newtube.mobile.ui.playback.PinchZoomLayout
            android:id="@+id/mobile_video_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@android:color/black"
            tools:ignore="Suspicious0dp">

            <!-- surface_type=none: the video renders on a code-managed TextureView with a
                 PERSISTENT SurfaceTexture (see MobilePlaybackActivity#setupVideoSurface). A
                 TextureView (not SurfaceView) because the swipe-down minimize MORPHS this view
                 and a SurfaceView goes BLACK under view transforms; and code-managed (not
                 PlayerView-managed) because PlayerView/SimpleExoPlayer detach the surface on
                 every view/activity hand-off, which forces a full video-codec re-init - seconds
                 of frozen frames while the audio keeps playing (worst on mini-player minimize/
                 expand). With one session-long SurfaceTexture the codec's surface NEVER changes;
                 the texture is simply re-parented between this view and the Browse mini card
                 (same technique as the YouTube app). PlayerView still does aspect-ratio,
                 subtitles and the double-tap layer. -->
            <com.github.vkay94.dtpv3.DoubleTapPlayerViewImpl
                android:id="@+id/mobile_player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <com.github.vkay94.dtpv3.youtube.YouTubeOverlay
                android:id="@+id/mobile_player_yt_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:yt_animationDuration="500"
                app:yt_seekSeconds="10" />

            <!-- Custom controls overlay. clickable so taps on empty space hide it. -->
            <FrameLayout
                android:id="@+id/mobile_controls_root"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/mobile_player_top_scrim_height"
                    android:layout_gravity="top"
                    android:background="@drawable/mobile_player_top_scrim" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/mobile_player_bottom_scrim_height"
                    android:layout_gravity="bottom"
                    android:background="@drawable/mobile_player_bottom_scrim" />

                <!-- Top bar: back + title -->
                <ImageButton
                    android:id="@+id/mobile_player_back"
                    android:layout_width="@dimen/mobile_player_icon_button"
                    android:layout_height="@dimen/mobile_player_icon_button"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mobile_player_back"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mobile_back_arrow" />

                <!-- paddingEnd must clear the full top-right options row (mobile_player_options):
                     up to 6 icon buttons * 40dp + 4dp end margin = 244dp. Otherwise the wrapped
                     title runs under the leftmost option (cast) icon. -->
                <TextView
                    android:id="@+id/mobile_player_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:paddingStart="56dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="248dp"
                    android:paddingBottom="12dp"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Video title goes here and may wrap onto a second line" />

                <!-- Top-right player options: Quality, Subtitles/CC, Speed. Each dispatches an
                     R.id.action_* through PlaybackPresenter.onButtonClicked/onButtonLongClicked so
                     the existing controllers open their AppDialog option lists (rendered by the
                     touch MobileAppDialogActivity). -->
                <LinearLayout
                    android:id="@+id/mobile_player_options"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Cast picker (casting wave): lists DIAL-discovered TVs + paired screens.
                         Route B only for now; see com.newtube.mobile.casting. -->
                    <ImageButton
                        android:id="@+id/mobile_player_cast"
                        android:layout_width="@dimen/mobile_player_icon_button"
                        android:layout_height="@dimen/mobile_player_icon_button"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/mobile_cast_button"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_mobile_cast" />

                    <ImageButton
                        android:id="@+id/mobile_player_quality"
                        android:layout_width="@dimen/mobile_player_icon_button"
                        android:layout_height="@dimen/mobile_player_icon_button"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/mobile_player_quality"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_quality" />

                    <ImageButton
                        android:id="@+id/mobile_player_subtitles"
                        android:layout_width="@dimen/mobile_player_icon_button"
                        android:layout_height="@dimen/mobile_player_icon_button"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/mobile_player_subtitles"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_cc" />

                    <ImageButton
                        android:id="@+id/mobile_player_speed"
                        android:layout_width="@dimen/mobile_player_icon_button"
                        android:layout_height="@dimen/mobile_player_icon_button"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/mobile_player_speed"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_speed" />

                    <ImageButton
                        android:id="@+id/mobile_player_pip"
                        android:layout_width="@dimen/mobile_player_icon_button"
                        android:layout_height="@dimen/mobile_player_icon_button"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/mobile_player_pip"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_pip" />

                    <!-- Overflow: opens the bottom-sheet menu of the long-tail player actions
                         (repeat/shuffle/zoom/background/screen-off/stats/rotate-lock/playlist/queue),
                         each dispatched through PlaybackPresenter.onButtonClicked/onButtonLongClicked. -->
                    <ImageButton
                        android:id="@+id/mobile_player_more"
                        android:layout_width="@dimen/mobile_player_icon_button"
                        android:layout_height="@dimen/mobile_player_icon_button"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/mobile_player_more"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_more" />

                </LinearLayout>

                <!-- Center transport: previous / play-pause-replay / next.
                     Previous & next dispatch PlaybackPresenter.onPreviousClicked / onNextClicked
                     (manual skip; auto-advance already works via the controllers). -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/mobile_player_previous"
                        android:layout_width="@dimen/mobile_player_icon_button"
                        android:layout_height="@dimen/mobile_player_icon_button"
                        android:layout_marginEnd="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/mobile_player_previous"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_previous" />

                    <!-- Large center play / pause / replay -->
                    <ImageButton
                        android:id="@+id/mobile_player_play_pause"
                        android:layout_width="@dimen/mobile_player_center_button"
                        android:layout_height="@dimen/mobile_player_center_button"
                        android:background="@drawable/mobile_player_center_button_bg"
                        android:contentDescription="@string/mobile_player_pause"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_pause" />

                    <ImageButton
                        android:id="@+id/mobile_player_next"
                        android:layout_width="@dimen/mobile_player_icon_button"
                        android:layout_height="@dimen/mobile_player_icon_button"
                        android:layout_marginStart="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/mobile_player_next"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_next" />

                </LinearLayout>

                <!-- Bottom seek block: the scrub-time chapter label (YouTube's subtle "which
                     chapter am I hovering" text, visible only while dragging the bar) stacked
                     above the seek row. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/mobile_player_scrub_chapter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingHorizontal="24dp"
                        android:paddingBottom="4dp"
                        android:shadowColor="#B3000000"
                        android:shadowRadius="4"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="Working With Strings" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/mobile_player_position"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/mobile_player_time_default"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/mobile_player_time_text" />

                    <!-- Time bar + SponsorBlock segment overlay share one cell so the colored
                         ranges line up exactly with the scrubber track underneath. -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1">

                        <androidx.media3.ui.DefaultTimeBar
                            android:id="@+id/mobile_player_time_bar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:bar_height="3dp"
                            app:buffered_color="#80FFFFFF"
                            app:played_color="@color/mobile_color_primary"
                            app:scrubber_color="@color/mobile_color_primary"
                            app:scrubber_enabled_size="14dp"
                            app:scrubber_dragged_size="18dp"
                            app:unplayed_color="#4DFFFFFF" />

                        <com.newtube.mobile.ui.playback.SeekBarSegmentsView
                            android:id="@+id/mobile_player_segments"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="false"
                            android:focusable="false" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/mobile_player_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/mobile_player_time_default"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/mobile_player_time_text" />

                    <!-- Live streams only (toggled from onProgressTick): red at the live edge,
                         dimmed while rewound into the DVR window; tap = jump back to the edge. -->
                    <TextView
                        android:id="@+id/mobile_player_live"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_mobile_live_chip"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:text="@string/mobile_player_live"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/mobile_player_time_text"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/mobile_player_fullscreen"
                        android:layout_width="@dimen/mobile_player_icon_button"
                        android:layout_height="@dimen/mobile_player_icon_button"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/mobile_player_fullscreen"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_fullscreen" />

                </LinearLayout>

                </LinearLayout>

            </FrameLayout>

            <!-- Center loading stack: the spinner plus (fresh installs only) the one-time-setup
                 hint shown while the first YouTube session is still being established. Both are
                 toggled from showProgressBar(); the wrapper collapses when they're gone. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/mobile_player_progress"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/mobile_color_primary"
                    android:indeterminateTintMode="src_in" />

                <TextView
                    android:id="@+id/mobile_player_setup_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:shadowColor="#B3000000"
                    android:shadowRadius="4"
                    android:text="@string/mobile_first_run_setup"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- "Stats for nerds" debug overlay. DebugInfoManager inflates R.layout.debug_view into
                 this group and toggles its visibility; it must not eat player taps, so it is not
                 clickable. Offset below the top scrim so it clears the back button / title. -->
            <FrameLayout
                android:id="@+id/mobile_player_debug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="56dp"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone" />

            <!-- "Playing on TV" panel (casting wave): covers the whole video box while a cast
                 session is active. Local playback is paused underneath (never torn down); this
                 panel is a self-contained remote - play/pause + disconnect + its own seek bar
                 driven by CastEvents (see the cast hooks in MobilePlaybackActivity). clickable so
                 taps never reach the player controls below it. -->
            <LinearLayout
                android:id="@+id/mobile_cast_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E6101010"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mobile_cast" />

                <TextView
                    android:id="@+id/mobile_cast_overlay_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingHorizontal="24dp"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Playing on Living room TV" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/mobile_cast_play_pause"
                        android:layout_width="@dimen/mobile_player_icon_button"
                        android:layout_height="@dimen/mobile_player_icon_button"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/mobile_player_play"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_pause" />

                    <TextView
                        android:id="@+id/mobile_cast_disconnect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/mobile_watch_pill_bg"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="@string/mobile_cast_disconnect"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Cast seek row: mirrors the player's bottom seek row but drives the TV. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <TextView
                        android:id="@+id/mobile_cast_position"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/mobile_player_time_default"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/mobile_player_time_text" />

                    <SeekBar
                        android:id="@+id/mobile_cast_seekbar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:layout_weight="1"
                        android:progressTint="@color/mobile_color_primary"
                        android:thumbTint="@color/mobile_color_primary" />

                    <TextView
                        android:id="@+id/mobile_cast_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/mobile_player_time_default"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/mobile_player_time_text" />

                </LinearLayout>

            </LinearLayout>

            <!-- Pinch-zoom hint chip ("Zoomed to fill" / "Original"), faded in/out from code. -->
            <TextView
                android:id="@+id/mobile_player_zoom_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="64dp"
                android:background="@drawable/bg_mobile_zoom_hint"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="@string/mobile_player_zoom_fill"
                tools:visibility="visible" />

        </com.newtube.mobile.ui.playback.PinchZoomLayout>

        <!-- Scrollable watch content (portrait only). -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/mobile_watch_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/mobile_color_background"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/mobile_watch_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/mobile_watch_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="@dimen/mobile_watch_content_padding"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="3"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="18sp"
                    tools:text="A great video title that may wrap across a couple of lines" />

                <!-- views + date + expand-description affordance -->
                <LinearLayout
                    android:id="@+id/mobile_watch_meta_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/mobile_watch_content_padding"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/mobile_watch_meta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/mobile_color_on_surface_secondary"
                        android:textSize="14sp"
                        tools:text="1,234,567 views • Jan 1, 2026" />

                    <ImageView
                        android:id="@+id/mobile_watch_expand"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/mobile_watch_description"
                        android:src="@drawable/ic_watch_expand" />

                </LinearLayout>

                <!-- Expandable description (collapsed by default) -->
                <TextView
                    android:id="@+id/mobile_watch_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="@dimen/mobile_watch_content_padding"
                    android:autoLink="web"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textColorLink="@color/mobile_color_link"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Video description text..."
                    tools:visibility="visible" />

                <!-- Actions row: segmented Like|Dislike pill (YouTube-style) + Share -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/mobile_watch_content_padding">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/mobile_watch_pill_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/mobile_watch_like"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="12dp"
                            android:paddingVertical="8dp">

                            <ImageView
                                android:id="@+id/mobile_watch_like_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@string/mobile_watch_like"
                                android:src="@drawable/ic_watch_thumb_up" />

                            <TextView
                                android:id="@+id/mobile_watch_like_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/mobile_watch_count_placeholder"
                                android:textColor="@color/mobile_color_on_surface"
                                android:textSize="14sp"
                                tools:text="12K" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="18dp"
                            android:background="@color/mobile_color_divider" />

                        <LinearLayout
                            android:id="@+id/mobile_watch_dislike"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="14dp"
                            android:paddingVertical="8dp">

                            <ImageView
                                android:id="@+id/mobile_watch_dislike_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@string/mobile_watch_dislike"
                                android:src="@drawable/ic_watch_thumb_down" />

                            <TextView
                                android:id="@+id/mobile_watch_dislike_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/mobile_watch_count_placeholder"
                                android:textColor="@color/mobile_color_on_surface"
                                android:textSize="14sp"
                                tools:text="123" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/mobile_watch_share"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/mobile_watch_pill_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@string/mobile_watch_share"
                            android:src="@drawable/ic_watch_share" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/mobile_watch_share"
                            android:textColor="@color/mobile_color_on_surface"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Channel row: avatar + name/subs + Subscribe. Sections separate by
                     whitespace, not hairline dividers (matches current YouTube).
                     The row itself opens the channel page (Subscribe keeps its own click). -->
                <LinearLayout
                    android:id="@+id/mobile_watch_channel_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/mobile_watch_content_padding"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:id="@+id/mobile_watch_avatar"
                        android:layout_width="@dimen/mobile_watch_avatar_size"
                        android:layout_height="@dimen/mobile_watch_avatar_size"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_watch_channel_placeholder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/mobile_watch_channel_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textColor="@color/mobile_color_on_surface"
                            android:textSize="15sp"
                            tools:text="Channel name" />

                        <TextView
                            android:id="@+id/mobile_watch_subs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/mobile_color_on_surface_secondary"
                            android:textSize="13sp"
                            android:visibility="gone"
                            tools:text="1.2M subscribers"
                            tools:visibility="visible" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_watch_subscribe"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@android:color/white"
                        android:fontFamily="sans-serif-medium"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:letterSpacing="0"
                        android:minHeight="40dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="0dp"
                        android:text="@string/mobile_watch_subscribe"
                        android:textAllCaps="false"
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        app:cornerRadius="20dp" />

                </LinearLayout>

                <!-- Comments entry: opens the comments bottom sheet. Hidden until the loaded
                     metadata reports that comments are enabled (a non-null comments key).
                     Rendered as a rounded surface card, like YouTube's comments teaser. -->
                <LinearLayout
                    android:id="@+id/mobile_watch_comments_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/mobile_watch_content_padding"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_watch_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="13dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_watch_comment" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/mobile_comments_entry"
                        android:textColor="@color/mobile_color_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:rotation="270"
                        android:src="@drawable/ic_watch_expand" />

                </LinearLayout>

                <!-- Live chat entry: opens the live-chat bottom sheet. Hidden unless the current
                     video is a live stream (a non-null live-chat key). -->
                <LinearLayout
                    android:id="@+id/mobile_watch_chat_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/mobile_watch_content_padding"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_watch_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="13dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_watch_chat" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/mobile_live_chat_entry"
                        android:textColor="@color/mobile_color_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:rotation="270"
                        android:src="@drawable/ic_watch_expand" />

                </LinearLayout>

                <!-- Related / up next -->
                <TextView
                    android:id="@+id/mobile_watch_related_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/mobile_watch_content_padding"
                    android:paddingTop="18dp"
                    android:paddingBottom="6dp"
                    android:text="@string/mobile_watch_related"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <include
                    layout="@layout/mobile_watch_related_skeleton"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mobile_watch_related"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_mobile_related_video" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</com.newtube.mobile.ui.playback.PlayerContainerLayout>
