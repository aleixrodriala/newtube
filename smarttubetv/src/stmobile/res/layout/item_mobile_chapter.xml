<?xml version="1.0" encoding="utf-8"?>
<!-- One chapter row in the chapters bottom sheet: timestamp chip + title. The current
     chapter is highlighted by ChaptersSheet (title tinted + bold timestamp chip). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chapter_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/chapter_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_video_badge"
        android:minWidth="52dp"
        android:gravity="center"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:textColor="@color/mobile_color_link"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="12:34" />

    <TextView
        android:id="@+id/chapter_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="15sp"
        tools:text="Chapter title" />

</LinearLayout>
