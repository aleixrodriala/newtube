<?xml version="1.0" encoding="utf-8"?>
<!-- A single search suggestion chip (tag). Tap = run that search; long-press =
     SearchPresenter.onTagLongClicked (remove from / clear search history). -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_search_tag_text"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:background="@drawable/mobile_search_tag_background"
    android:clickable="true"
    android:ellipsize="end"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:maxLines="1"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp"
    android:textColor="@color/mobile_color_on_surface"
    android:textSize="14sp"
    tools:text="lofi hip hop" />
