<?xml version="1.0" encoding="utf-8"?>
<!--
  Simple player options sheet (YouTube-style): a short "Quality" list (Auto + the video's
  distinct resolutions) and, when the video ships multiple audio languages, an "Audio" list.
  Rows are item_mobile_quality_row, filled in MobilePlaybackActivity.showQualitySheet().
  Replaces the TV HQ dialog (every codec/fps variant) as the tap target of the quality button -
  the full dialog stays reachable from the overflow menu for power users.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mobile_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_mobile_sheet_handle" />

        <TextView
            android:id="@+id/quality_sheet_quality_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:text="@string/mobile_quality_title"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/quality_sheet_quality_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:id="@+id/quality_sheet_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/mobile_color_divider" />

        <TextView
            android:id="@+id/quality_sheet_audio_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:text="@string/mobile_audio_title"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/quality_sheet_audio_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
