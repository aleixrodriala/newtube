<?xml version="1.0" encoding="utf-8"?>
<!--
  Touch Channel-Uploads list (Wave 4a).

  A single Material RecyclerView GRID of the uploads/playlist contents (reuses
  VideoCardAdapter + the same runtime span-count math as the Home grid), under a simple
  Toolbar with the list title + a back arrow. No bottom nav: this is a pushed detail
  screen (parent = MobileBrowseActivity), so back returns to wherever it was opened from.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/mobile_channel_uploads_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mobile_color_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/mobile_channel_uploads_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:background="@color/mobile_color_background"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/mobile_channel_uploads_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_back"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_back_arrow" />

        <TextView
            android:id="@+id/mobile_channel_uploads_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingEnd="16dp"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Daily Top Music Videos" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mobile_channel_uploads_play_all"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:backgroundTint="@android:color/white"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="40dp"
            android:paddingHorizontal="14dp"
            android:text="@string/mobile_playlist_play_all"
            android:textAllCaps="false"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            android:visibility="gone"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_player_play"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@android:color/black"
            tools:visibility="visible" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_channel_uploads_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/mobile_card_spacing"
            android:paddingBottom="@dimen/mobile_card_spacing"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_video_card" />

        <ProgressBar
            android:id="@+id/mobile_channel_uploads_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>

    <!-- Minimizing a video opened from this list keeps playback alive in this overlay. -->
    <include layout="@layout/mobile_mini_player_overlay" />

</FrameLayout>
