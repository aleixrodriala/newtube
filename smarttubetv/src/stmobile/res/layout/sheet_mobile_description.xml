<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_mobile_sheet">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_mobile_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif-medium"
            android:text="@string/mobile_watch_description"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/description_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_sheet_close"
            android:padding="12dp"
            android:src="@drawable/ic_sheet_close"
            android:tint="@color/mobile_color_on_surface" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/mobile_color_divider" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/description_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/mobile_color_on_surface"
                android:textIsSelectable="true"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/description_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/description_channel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/mobile_color_on_surface"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <com.newtube.mobile.ui.playback.SelectableLinkTextView
                android:id="@+id/description_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/mobile_color_on_surface"
                android:textColorLink="@color/mobile_color_link"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/description_chapters_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/chapters"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="16sp" />

            <com.newtube.mobile.ui.playback.SelectableLinkTextView
                android:id="@+id/description_chapters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/mobile_color_on_surface"
                android:textColorLink="@color/mobile_color_link"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
