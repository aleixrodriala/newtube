<?xml version="1.0" encoding="utf-8"?>
<!--
  Single flexible row used for every OptionItem "kind" the touch AppDialog renderer
  supports (button / radio / checkbox / switch / read-only text). DialogRowAdapter toggles
  which trailing control (if any) is visible and whether the row is clickable per row type,
  instead of maintaining five near-identical layouts.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dialog_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/dialog_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp"
            tools:text="Option title" />

        <TextView
            android:id="@+id/dialog_row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Description"
            tools:visibility="visible" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/dialog_row_control"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp">

        <RadioButton
            android:id="@+id/dialog_row_radio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/dialog_row_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/dialog_row_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
