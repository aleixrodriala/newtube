<?xml version="1.0" encoding="utf-8"?>
<!--
  A single live-chat message for LiveChatSheet/LiveChatAdapter: small circular author
  avatar, then the author name (bold) followed inline by the message text.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/chat_avatar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="1dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_watch_channel_placeholder" />

    <TextView
        android:id="@+id/chat_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="13sp"
        tools:text="Author name  This is a live chat message" />

</LinearLayout>
