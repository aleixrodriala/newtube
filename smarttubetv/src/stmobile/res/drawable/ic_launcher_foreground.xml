<?xml version="1.0" encoding="utf-8"?>
<!--
  NewTube adaptive-icon foreground (stmobile flavor).

  The NewTube "arch" mark: a lowercase-n arch (which also reads as a
  tunnel/tube), white, optically centred inside the 66x66 adaptive safe zone (nudged 2 units up: the arch is bottom-heavy, so geometric centring reads low)
  (viewport 108, safe area ~21..87) so no launcher mask clips it.
  The stroke matches the fill and only softens the corners.
  Deliberately NOT a play triangle — see docs/gtm + legal notes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M32,76 L32,53 A22,22 0 0 1 76,53 L76,76 L63,76 L63,53 A9,9 0 0 0 45,53 L45,76 Z" />
</vector>
