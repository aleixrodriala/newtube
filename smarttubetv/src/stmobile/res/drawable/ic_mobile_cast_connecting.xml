<?xml version="1.0" encoding="utf-8"?>
<!-- Official-app-style cast "connecting" animation: the glyph's wifi arcs fill 1 -> 2 -> 3 in a
     loop (frame 3/3 is the complete stock icon). Started/stopped by
     MobileBrowseActivity.updateCastIconTint. -->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="false">
    <item android:drawable="@drawable/ic_mobile_cast_connecting_0" android:duration="500" />
    <item android:drawable="@drawable/ic_mobile_cast_connecting_1" android:duration="500" />
    <item android:drawable="@drawable/ic_mobile_cast" android:duration="500" />
</animation-list>
