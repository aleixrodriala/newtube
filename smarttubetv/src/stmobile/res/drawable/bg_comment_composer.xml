<?xml version="1.0" encoding="utf-8"?>
<!-- NEWTUBE(write-comments): the comment composer docked above the keyboard (CommentComposer): the
     surface with rounded top corners, edged along the top by a hairline so it stays apart from
     the list behind it in the light theme too (the composer has no dim). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mobile_color_divider" />
            <corners
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/newtubeColorSurface" />
            <corners
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp" />
        </shape>
    </item>
</layer-list>
