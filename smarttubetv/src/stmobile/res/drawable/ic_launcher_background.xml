<?xml version="1.0" encoding="utf-8"?>
<!--
  NewTube adaptive-icon background (stmobile flavor).

  Full-bleed 108x108 layer; the launcher applies its own mask (circle / rounded
  square / squircle) on top. A deep red base with a slightly darker lower-right
  wedge gives the flat mark a touch of depth without a gradient tag (keeps aapt
  happy on the pinned AGP 7.4.2 / build-tools 30.x toolchain).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#E1140F"
        android:pathData="M0,0h108v108h-108z" />
    <path
        android:fillColor="#C10D0A"
        android:pathData="M108,0 L108,108 L0,108 Z" />
</vector>
