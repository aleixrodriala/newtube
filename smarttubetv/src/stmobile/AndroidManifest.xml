<?xml version="1.0" encoding="utf-8"?>
<!--
  Mobile (touch) flavor manifest overlay.

  Overrides the TV manifest so the app installs and shows in the launcher on
  ordinary touchscreen phones/tablets:
    * android.software.leanback  -> NOT required (TV manifest + leanbackassistant
      both declare it required=true; tools:replace forces the merged value false).
    * android.hardware.touchscreen -> required (TV manifest declares it false).

  SplashActivity already carries the normal LAUNCHER category in the main manifest,
  so no launcher changes are needed here - it routes via SplashPresenter ->
  ViewManager.startView(BrowseView.class)/startDefaultView(), both of which are
  re-pointed at the touch Home screen below (see MobileMainApplication).

  Wave 1 vertical slice: override the Application class to MobileMainApplication
  (re-points just the BrowseView mapping + root activity at the touch shell; every
  other TV View->Activity mapping from MainApplication.setupViewManager() is left
  intact) and declare the touch Home Activity itself.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false"
        tools:replace="android:required" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true"
        tools:replace="android:required" />

    <application
        android:name="com.newtube.mobile.MobileMainApplication"
        android:theme="@style/Theme.NewTube"
        tools:replace="android:name,android:theme">

        <activity
            android:name="com.newtube.mobile.ui.browse.MobileBrowseActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.NewTube" />

    </application>

</manifest>
