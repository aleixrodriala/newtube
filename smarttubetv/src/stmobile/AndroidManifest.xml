<?xml version="1.0" encoding="utf-8"?>
<!--
  Mobile (touch) flavor manifest overlay.

  Overrides the TV manifest so the app installs and shows in the launcher on
  ordinary touchscreen phones/tablets:
    * android.software.leanback  -> NOT required (TV manifest + leanbackassistant
      both declare it required=true; tools:replace forces the merged value false).
    * android.hardware.touchscreen -> required (TV manifest declares it false).

  SplashActivity already carries the normal LAUNCHER category in the main manifest,
  so no launcher changes are needed here - it routes via SplashPresenter ->
  ViewManager.startView(BrowseView.class)/startDefaultView(), both of which are
  re-pointed at the touch Home screen below (see MobileMainApplication).

  Wave 1 vertical slice: override the Application class to MobileMainApplication
  (re-points just the BrowseView mapping + root activity at the touch shell; every
  other TV View->Activity mapping from MainApplication.setupViewManager() is left
  intact) and declare the touch Home Activity itself.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false"
        tools:replace="android:required" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true"
        tools:replace="android:required" />

    <application
        android:name="com.newtube.mobile.MobileMainApplication"
        android:theme="@style/Theme.NewTube"
        tools:replace="android:name,android:theme">

        <activity
            android:name="com.newtube.mobile.ui.browse.MobileBrowseActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.NewTube" />

        <!--
          Touch player (Wave 2). configChanges covers orientation/screenSize/keyboardHidden so
          the Activity (and the live ExoPlayer instance it holds) survives device rotation
          instead of being torn down and recreated - rotating to landscape is exactly how the
          user reaches fullscreen. screenOrientation="unspecified" lets the system/sensor decide
          (same as every other touch screen in this flavor), so portrait playback still works on
          devices/users with auto-rotate off.
        -->
        <activity
            android:name="com.newtube.mobile.ui.playback.MobilePlaybackActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.NewTube" />

        <!--
          Touch AppDialog renderer (Wave 3). configChanges/launchMode mirror the other
          registered View Activities: ViewManager.startActivity() always launches with
          FLAG_ACTIVITY_NEW_TASK from a non-Activity Context, and surviving rotation matters
          here too - the in-memory dialog level backstack (and the OptionItem callback
          closures captured by it) would otherwise be lost on a config change.
        -->
        <activity
            android:name="com.newtube.mobile.ui.dialog.MobileAppDialogActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.NewTube" />

        <!--
          Touch Channel-Uploads list + Channel page (Wave 4a). Same singleInstance +
          configChanges pattern as the other touch Activities: ViewManager.startActivity()
          launches with FLAG_ACTIVITY_NEW_TASK, and surviving rotation keeps the loaded
          content (and the presenter's in-flight Rx load) instead of recreating the screen.
        -->
        <activity
            android:name="com.newtube.mobile.ui.channel.MobileChannelUploadsActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.NewTube" />

        <activity
            android:name="com.newtube.mobile.ui.channel.MobileChannelActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.NewTube" />

        <!--
          Touch Search screen (Wave 4b). Same singleInstance + configChanges pattern as the
          other touch Activities (ViewManager.startActivity() launches with FLAG_ACTIVITY_NEW_TASK;
          surviving rotation keeps the loaded results + the presenter's in-flight Rx load).
          adjustResize so the results grid shrinks (rather than being covered) when the soft
          keyboard is up while typing a query.
        -->
        <activity
            android:name="com.newtube.mobile.ui.search.MobileSearchActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.NewTube" />

        <!--
          Touch device-code sign-in screen (Wave 5, ARCHITECTURE.md section 7). Same
          singleInstance + configChanges pattern as the other touch Activities:
          ViewManager.startActivity() launches with FLAG_ACTIVITY_NEW_TASK, and surviving
          rotation keeps the live device-code OAuth poll (the YTSignInPresenter Rx subscription)
          and the already-rendered code/QR instead of restarting the whole sign-in flow.
        -->
        <activity
            android:name="com.newtube.mobile.ui.signin.MobileSignInActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.NewTube" />

    </application>

</manifest>
